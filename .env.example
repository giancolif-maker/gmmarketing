# Copy this file to .env and fill in real values. Never commit .env.

# Gmail sending accounts (add as many GMAIL_N_* pairs as you have).
# App passwords: https://myaccount.google.com/apppasswords
GMAIL_1_ADDRESS=you1@gmail.com
GMAIL_1_APP_PASSWORD=xxxx xxxx xxxx xxxx

GMAIL_2_ADDRESS=you2@gmail.com
GMAIL_2_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Sheets logging
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# Instagram Graph API (for lead_finder.py — hashtag discovery + profile
# lookups). Requires a Facebook App and an Instagram Business/Creator
# account. See README "Streetwear IG Lead Finder" section for setup.
# Leave blank and run lead_finder.py with --mock to test without these.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# AI/ML API key (for lead_finder.py's DM draft generation, dm_draft.py).
# Free tier: aimlapi.com. Leave blank / use --no-drafts to skip
# draft generation.
AIML_API_KEY=
