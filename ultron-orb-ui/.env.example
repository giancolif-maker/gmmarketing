# ULTRON's brain — any OpenAI-compatible chat-completions provider works.
#
# Option A: OpenRouter (https://openrouter.ai/keys) — access to many models
# through one key. Good defaults with tool-calling + vision:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-sonnet-4.5
#
# Option B: Groq (https://console.groq.com/keys) — very fast inference.
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Set to "true" to run the browser agent headless (no visible window) — e.g.
# on a server with no display. Defaults to false so you can actually see
# ULTRON's browser window open on your screen.
ULTRON_BROWSER_HEADLESS=false
