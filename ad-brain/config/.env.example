# Meta Marketing API credentials
# https://developers.facebook.com/docs/marketing-apis/get-started
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# Optional: notification channels for alerts
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Optional: powers the chat panel with real Claude responses.
# Without this set, chat falls back to a simpler grounded responder that
# reads straight from the database — still real answers, just not an LLM.
ANTHROPIC_API_KEY=

# Flask session secret — set a real random value before deploying anywhere
# other than your own machine.
FLASK_SECRET_KEY=
